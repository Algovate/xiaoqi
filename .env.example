# --- 基础 ---
DATABASE_URL=postgres://xiaoqi:xiaoqi@127.0.0.1:5432/xiaoqi
REDIS_URL=redis://127.0.0.1:6379
MASTER_KEY=replace-with-base64-32-bytes
INTERNAL_TOKEN=replace-with-random-token
LOG_LEVEL=info

# --- iLink ---
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_APP_ID=bot
ILINK_APP_VERSION=132106
ILINK_GROUP_REPLY_TARGET=sender

# --- LLM ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_VISION_MODEL=deepseek-flash
LLM_TIMEOUT_MS=60000

# --- 服务 ---
GATEWAY_PORT=4101
GATEWAY_INTERNAL_URL=http://127.0.0.1:4101
WORKER_HEALTH_PORT=4102

MEDIA_DIR=./data/media

OCR_ENABLED=auto
OCR_BIN=

ADMIN_TOKEN=replace-with-admin-token
API_PORT=4100
API_HOST=127.0.0.1
MAX_DAILY_TOKENS=100000

ALERT_WEBHOOK_URL=

# Codex runner（alias=绝对路径，逗号分隔）
CODEX_BIN=codex
CODEX_REPOS=xiaoqi=/path/to/repo
CODEX_ALLOWED_USERS=your_wx_user_id@im.wechat
CODEX_TIMEOUT_MS=900000
